# ── ExportAI Docker Compose Environment Variables ─────────────
# Copy this file to .env and update the values before running docker-compose up.

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=exportai
POSTGRES_PASSWORD=exportai_secret
POSTGRES_DB=exportai

# ── 后端 API ──────────────────────────────────────────────────
DATABASE_URL=postgresql://exportai:exportai_secret@postgres:5432/exportai?schema=public

# IMPORTANT: Change JWT_SECRET to a strong random string in production!
# Generate one with: openssl rand -base64 48
JWT_SECRET=your-jwt-secret-min-32-chars-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 邮件服务: ethereal (dev) | resend (production)
MAIL_PROVIDER=ethereal
RESEND_API_KEY=
MAIL_FROM=noreply@exportai.com

PORT=4000
NODE_ENV=development

# CORS: Add your Chrome extension ID and domain
ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID,http://localhost:3000

# 前端 URL（用于生成密码重置链接等）
WEB_URL=http://localhost:3000

# ── 前端 ──────────────────────────────────────────────────────
# This is a build-time variable — it gets embedded during next build.
# In Docker, the Next.js rewrites proxy handles API requests,
# so this value is used for the proxy target and client-side fallback.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CHROME_EXTENSION_URL=https://chromewebstore.google.com
NEXT_PUBLIC_EDGE_EXTENSION_URL=https://microsoftedge.microsoft.com/addons

# Notion public integration OAuth credentials
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
