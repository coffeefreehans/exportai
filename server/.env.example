# ── ExportAI Server Environment Variables ──────────────────────
# Copy this file to .env and update the values before running.

# ── 数据库 ────────────────────────────────────────────────────
# Docker: use the service name 'postgres' as host
# Local:  use localhost
DATABASE_URL=postgresql://exportai:exportai_secret@postgres:5432/exportai?schema=public

# ── JWT 认证 ──────────────────────────────────────────────────
# IMPORTANT: Change JWT_SECRET to a strong random string in production!
# Generate one with: openssl rand -base64 48
JWT_SECRET=your-jwt-secret-min-32-chars-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── 邮件服务 ──────────────────────────────────────────────────
# ethereal: free test email (dev only, preview URLs logged to console)
# resend:   production email via Resend API
MAIL_PROVIDER=ethereal
RESEND_API_KEY=
MAIL_FROM=noreply@exportai.com

# ── 服务器 ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# For Chrome extension, use: chrome-extension://YOUR_EXTENSION_ID
# For production, replace localhost with your actual domain.
ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID,http://localhost:3000

# ── 前端 URL ──────────────────────────────────────────────────
# Used for generating password reset links and other URLs.
WEB_URL=http://localhost:3000
